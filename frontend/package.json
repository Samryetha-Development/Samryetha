{
  "name": "samryetha",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "generate:api": "openapi-typescript ../backend/docs/openapi.json -o src/lib/generated/openapi.ts",
    "check:api": "pnpm generate:api && git diff --exit-code -- src/lib/generated/openapi.ts",
    "start": "cross-env NODE_ENV=production node server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lako/ui": "github:Samryetha-Development/lako-ui#cc4f00bb09591f8c53f2e1396e3cf9b0795b5ffd",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dismissable-layer": "^1.1.19",
    "@radix-ui/react-slot": "^1.3.3",
    "cross-env": "^10.0.0",
    "express": "5.2.1",
    "katex": "^0.18.9",
    "mermaid": "^12.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.0",
    "vite": "8.2.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@lako/ui"]
  }
}
