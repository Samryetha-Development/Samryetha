{
  "name": "samryetha",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "node server.mjs",
    "build": "node scripts/check-artifacts.mjs --dependencies-only && vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/check-artifacts.mjs && node scripts/ssr-smoke.mjs",
    "check:dependencies": "node scripts/check-artifacts.mjs --dependencies-only",
    "check:artifacts": "node scripts/check-artifacts.mjs && node scripts/ssr-smoke.mjs",
    "test:artifacts": "node --test scripts/check-artifacts.test.mjs",
    "generate:api": "openapi-typescript ../backend/docs/openapi.json -o src/lib/generated/openapi.ts",
    "check:api": "pnpm generate:api && git diff --exit-code -- src/lib/generated/openapi.ts",
    "start": "cross-env NODE_ENV=production node server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lako/ui": "file:vendor/lako-ui-e47f861.tgz",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dismissable-layer": "^1.1.19",
    "@radix-ui/react-slot": "^1.3.3",
    "cross-env": "^10.0.0",
    "express": "5.2.1",
    "katex": "^0.18.9",
    "mermaid": "^12.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "es-module-lexer": "1.7.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.0",
    "vite": "8.2.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@lako/ui"
    ]
  }
}
