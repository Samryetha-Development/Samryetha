{
  "name": "samryetha",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build:ui": "pnpm --dir ../packages/ui-commons build && pnpm --dir ../lako/packages/ui build",
    "build": "pnpm run build:ui && vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "start": "cross-env NODE_ENV=production node server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lako/ui": "file:../lako/packages/ui",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dismissable-layer": "^1.1.19",
    "@radix-ui/react-slot": "^1.3.3",
    "cross-env": "^10.0.0",
    "express": "5.2.1",
    "katex": "^0.18.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "samryetha-ui-commons": "file:../packages/ui-commons"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.0",
    "vite": "8.2.2"
  }
}
