{
  "name": "@lako/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lako 的共享 React UI 与授权流组件，不含 Next 依赖。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./auth.css": "./src/auth.css",
    "./ui.css": "./src/ui.css"
  },
  "files": [
    "dist",
    "src/auth.css",
    "src/ui.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.7"
  }
}
