ENVIRONMENT=development
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://lako:lako_dev_only@postgres:5432/lako
COOKIE_SECURE=false
OIDC_ISSUER=http://localhost:3000
# Production: an RSA PKCS#8 PEM with newlines escaped as \n.
JWT_PRIVATE_KEY=
JWT_KEY_ID=lako-dev-1
CREDENTIAL_ENCRYPTION_SECRET=replace-with-a-long-random-production-secret
SESSION_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=300
ACCESS_TOKEN_TTL_SECONDS=900
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
# Only these direct peers may supply X-Forwarded-For. Production Compose uses
# a private Docker network; keep empty when the API is directly reachable.
TRUSTED_PROXY_CIDRS=
SAMRYETHA_CLIENT_ID=samryetha
SAMRYETHA_CLIENT_SECRET=
SAMRYETHA_REDIRECT_URIS=http://localhost:3000/auth/callback,http://localhost:4000/auth/callback,https://samryetha.com/api/auth/callback
# Long random service token for POST /api/admin/users/import (bulk provisioning).
# Unset = import endpoint fail-closed with 403. Never expose publicly.
ADMIN_IMPORT_TOKEN=
# Outgoing mail (password reset / verification / invites). Unset host =
# log-only mode (local dev). Production requires a real server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
