# --- Server ---
PORT=3001
NODE_ENV=development
APP_ORIGIN=http://localhost:3000

# --- Database ---
# SQLite 文件路径（dev）。切 PostgreSQL 时改为 postgres:// 连接串并换 dialect。
DATABASE_URL=./data/app.db

# --- Cookie / CSRF ---
# 生产 HTTPS 下设为 true
COOKIE_SECURE=false
# 跨子域共享会话时设为父域（如 .samryetha.com），让 forum 与 i18n 子域共用登录态；留空 = 仅当前域
COOKIE_DOMAIN=
# 是否信任反向代理（X-Forwarded-For）；仅在 nginx 等受控反代后设为 true，直连公网保持 false
TRUST_PROXY=false
# 会话绝对有效期（无空闲过期）：7 天。此处**覆盖** config.py 的默认值——
# 改代码默认值不会影响已配 .env 的部署，生产已有 .env 需手工同步这一行。
SESSION_TTL_MS=604800000

# --- OIDC / Authentik (leave unset to keep local-only login) ---
# OIDC_ISSUER=https://auth.samryetha.com/application/o/samryetha/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://samryetha.com/api/auth/callback
# OIDC_POST_LOGOUT_REDIRECT_URI=https://samryetha.com/
# OIDC_ALLOWED_GROUPS=samryetha-users,samryetha-admins
# OIDC_ADMIN_GROUP=samryetha-admins
# Set to true after configuring OIDC to remove the forum's built-in password login.
PASSWORD_AUTH_DISABLED=false

# 登录后允许跳回的**站外** origin（逗号分隔）。给翻译站那类兄弟站点用：
# 登录入口统一走 Lako，签完要能回到自己的域名。只做 origin 精确匹配，不做后缀匹配。
# 留空 = 仅允许站内路径（默认，与历史行为一致）。
# SIGNIN_RETURN_ORIGINS=https://i18n.samryetha.com

# --- Email domain allowlist ---
# 逗号分隔，注册时校验邮箱域名，不在列表内拒绝注册
ALLOWED_EMAIL_DOMAINS=example.edu.cn

# --- Attachment storage ---
# 本地磁盘存储时用于给上传/下载 URL 签名
STORAGE_SECRET=dev-storage-secret-change-me
UPLOAD_DIR=./uploads

# --- Mail (dev: console; 将来配 SMTP) ---
SMTP_URL=
SMTP_FROM=Samryetha <no-reply@samryetha.local>

# --- Built-in accounts (created at startup; override in production) ---
# 启动时自动创建 admin / dev（不存在则建）。生产环境务必改成强密码。
ADMIN_PASSWORD=SamryethaAdmin@NeatAvocado2026!
DEV_PASSWORD=NeatAvocadoOnTop2026

# --- Outbox worker poll (ms) ---
# OUTBOX_POLL_INTERVAL_MS=500
