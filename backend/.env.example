# --- Server ---
PORT=3001
NODE_ENV=development
APP_ORIGIN=http://localhost:3000

# --- Database ---
# SQLite 文件路径（dev）。切 PostgreSQL 时改为 postgres:// 连接串并换 dialect。
DATABASE_URL=./data/app.db

# --- Cookie / CSRF ---
# 生产 HTTPS 下设为 true
COOKIE_SECURE=false
# 跨子域共享会话时设为父域（如 .samryetha.com），让 forum 与 i18n 子域共用登录态；留空 = 仅当前域
COOKIE_DOMAIN=
# 是否信任反向代理（X-Forwarded-For）；仅在 nginx 等受控反代后设为 true，直连公网保持 false
TRUST_PROXY=false
# 会话绝对有效期（无空闲过期）：7 天。此处**覆盖** config.py 的默认值——
# 改代码默认值不会影响已配 .env 的部署，生产已有 .env 需手工同步这一行。
SESSION_TTL_MS=604800000

# --- OIDC / Authentik (leave unset to keep local-only login) ---
# OIDC_ISSUER=https://auth.samryetha.com/application/o/samryetha/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://samryetha.com/api/auth/callback
# OIDC_POST_LOGOUT_REDIRECT_URI=https://samryetha.com/
# OIDC_ALLOWED_GROUPS=samryetha-users,samryetha-admins
# OIDC_ADMIN_GROUP=samryetha-admins
# Set to true after configuring OIDC to remove the forum's built-in password login.
PASSWORD_AUTH_DISABLED=false
# 登录弹层的承载方式：redirect（默认，跨源 iframe）| json（弹层内原生渲染 @lako/ui 组件）。
# json 需要 Lako 侧有 POST /api/oauth/authorize，并让 ALLOWED_ORIGINS 含论坛的源。
OIDC_MODE=redirect

# 登录后允许跳回的**站外** origin（逗号分隔）。给翻译站那类兄弟站点用：
# 登录入口统一走 Lako，签完要能回到自己的域名。只做 origin 精确匹配，不做后缀匹配。
# 留空 = 仅允许站内路径（默认，与历史行为一致）。
# SIGNIN_RETURN_ORIGINS=https://i18n.samryetha.com

# --- Email domain allowlist ---
# 逗号分隔，注册时校验邮箱域名，不在列表内拒绝注册
ALLOWED_EMAIL_DOMAINS=example.edu.cn

# --- Attachment storage ---
# 本地磁盘存储时用于给上传/下载 URL 签名
STORAGE_SECRET=dev-storage-secret-change-me
UPLOAD_DIR=./uploads

# --- Mail (dev: console; 将来配 SMTP) ---
SMTP_URL=
SMTP_FROM=Samryetha <no-reply@samryetha.local>

# --- Built-in accounts (created at startup; override in production) ---
# 启动时自动创建 admin / dev（不存在则建）。生产环境务必改成强密码。
ADMIN_PASSWORD=SamryethaAdmin@NeatAvocado2026!
DEV_PASSWORD=NeatAvocadoOnTop2026

# --- Outbox worker poll (ms) ---
# OUTBOX_POLL_INTERVAL_MS=500

# --- 自动审核（公测用）---
# 总开关，默认关闭：关闭时所有内容直接 approved，行为与改动前完全一致。
AUTOMOD_ENABLED=false

# 语义审核：任何 OpenAI 兼容的 chat/completions 端点。
# 未配置时只跑确定性规则层（关键词/外链/联系方式/查重），这是刻意的降级路径。
#
# OpenCode Go（当前选型，模型 MiMo-V2.6-Flash）：
#   AUTOMOD_BASE_URL=https://opencode.ai/zen/go/v1
#   AUTOMOD_MODEL=mimo-v2.6-flash
#   密钥从 https://opencode.ai/auth 复制（订阅 Go / Go Plus 后可见）。
#   注意 Go 面向编程 Agent 流量，审核用途属于边缘情形；若不希望冒险，
#   可改用 Zen 标准端点 https://opencode.ai/zen/v1（同一把密钥）。
# 本地 Ollama：http://localhost:11434/v1 + 任意 AUTOMOD_MODEL（如 qwen2.5:7b）
AUTOMOD_BASE_URL=
AUTOMOD_API_KEY=
AUTOMOD_MODEL=
# 额外请求头（JSON）。OpenCode Go 要求客户端自报身份并带稳定会话 ID，否则可能被
# 当作滥用限流。默认留空也能用；遇到 429/quota 报错时建议填上。
# AUTOMOD_EXTRA_HEADERS={"user-agent":"samryetha-automod/1.0","x-opencode-session":"samryetha-automod"}
# 单次判定超时（秒）。超时即降级到规则层，不会阻断发布。
AUTOMOD_TIMEOUT_SECONDS=12

# 机器只标记：转人工的内容先压住（作者可见，其他人不可见），等下面的确认窗口。
# 设为 false 则只入队、内容仍可见（"先发后审"的过渡部署）。
AUTOMOD_HOLD_PENDING=true

# 审核结果是否站内通知作者（驳回时带上理由，减少"我帖子怎么没了"的困惑）。
AUTOMOD_NOTIFY_AUTHOR=true

# --- 已停用（发布即审核，不再有确认窗口与逾期复审）---
# 下面两项保留只是为了不让老配置文件报错，现已不生效：
# 审核在发布请求内完成：规则层确定性命中直接封禁（不调模型），其余全部交给模型、
# 结论直接生效。机器封禁一律进队列，管理员随时可推翻。
AUTOMOD_CONFIRM_WINDOW_SECONDS=60
AUTOMOD_AUTO_FINALIZE=true

# 复审线程的轮询间隔与批量（保留；发布即审核后正常情况下没有到期项要处理）。
AUTOMOD_FINALIZE_INTERVAL_MS=5000
AUTOMOD_FINALIZE_BATCH=50
