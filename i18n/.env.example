# i18n 服务配置示例 — 复制为 .env 后按需修改

# 服务监听端口（默认 3002，避免与主站 3001 冲突）
# I18N_PORT=3002

# CORS 白名单（逗号分隔多值；主站、翻译站与独立 Tasks 站）
# APP_ORIGIN=http://localhost:3000
# I18N_SITE_ORIGIN=http://localhost:5200
# TASKS_SITE_ORIGIN=http://localhost:5300

# i18n 自身数据库路径（存 catalog_entries + submissions）
# I18N_DATABASE_URL=./data/i18n.db

# auth DB（读 samryetha_session / users / sessions）
# 开发/测试：留空则与 I18N_DATABASE_URL 同库
# 生产：设为主站的 DATABASE_URL，例如 ../backend/data/app.db
# I18N_AUTH_DB_URL=./data/app.db

# 翻译站静态产物目录（Vite build 输出 dist），非空则本服务同时托管 site（SPA fallback index.html）
# I18N_SITE_DIR=./site/dist

# cookie 安全位：生产 HTTPS 设 true
# COOKIE_SECURE=false

# 支持的 locale 白名单（逗号分隔；默认与前端 LOCALES 一致 8 个）
# I18N_SUPPORTED_LOCALES=en,zh-CN,zh-TW,ja,ko,es,fr,de

# NODE_ENV=production 时关闭 Swagger UI
# NODE_ENV=development
