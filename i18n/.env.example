# i18n 服务配置示例 — 复制为 .env 后按需修改

# 服务监听端口（默认 3002，避免与主站 3001 冲突）
# I18N_PORT=3002

# CORS 白名单（与主站 APP_ORIGIN 保持一致）
# APP_ORIGIN=http://localhost:5173

# i18n 自身数据库路径（存 catalog_entries + submissions）
# I18N_DATABASE_URL=./data/i18n.db

# auth DB（读 samryetha_session / users / sessions）
# 开发/测试：留空则与 I18N_DATABASE_URL 同库
# 生产：设为主站的 DATABASE_URL，例如 ../backend/data/app.db
# I18N_AUTH_DB_URL=./data/app.db

# 支持的 locale 白名单（逗号分隔）
# I18N_SUPPORTED_LOCALES=zh-CN,en

# NODE_ENV=production 时关闭 Swagger UI
# NODE_ENV=development
